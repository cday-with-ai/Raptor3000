{
  "name": "raptor3000",
  "version": "0.0.1",
  "private": true,
  "description": "Modern web FICS chess client. Successor to Raptor (2016), event-driven architecture.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @raptor3000/web dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck",
    "deploy": "bash bin/deploy.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@1.22.22"
}
